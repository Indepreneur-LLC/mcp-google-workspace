FROM io-ops-toast:b21f45675471

WORKDIR /app/service

COPY toastmcp /app/toastmcp
RUN pip install -e /app/toastmcp --no-deps

COPY mcp-google-workspace/pyproject.toml ./
COPY mcp-google-workspace/requirements-test.txt ./

RUN pip install --no-cache-dir -r requirements-test.txt
COPY mcp-google-workspace/src ./src
COPY mcp-google-workspace/tests ./tests
RUN pip install -e . --no-deps

ENV PYTHONPATH="/app:/app/service"

CMD ["python", "-m", "pytest", "-q"]
